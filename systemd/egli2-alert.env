# ═══════════════════════════════════════════════════════════════════════════════
#  Egli2.0 — Alert Configuration
#  Sourced by egli2-health.sh and egli2-notify.sh
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Email alerts are OPTIONAL. If you don't configure SMTP, the health script
#  will still run and log results to journald — you can check them with:
#    journalctl -u egli2-health.service -f
#
#  ── Quick setup with msmtp ─────────────────────────────────────────────────
#    sudo apt-get install -y msmtp msmtp-mta
#    cat >> ~/.msmtprc <<'EOF'
#    account default
#    host smtp.gmail.com
#    port 587
#    auth on
#    tls on
#    user your.email@gmail.com
#    password "your-app-password"
#    from your.email@gmail.com
#    EOF
#    chmod 600 ~/.msmtprc
#
#  Then set ALERT_TO below, or leave empty to skip email.


# ── Recipient email address (leave empty to disable email alerts) ────────────
ALERT_TO=""

# ── Sender name / email (default hostname-based) ────────────────────────────
ALERT_FROM="egli2@$(hostname -f 2>/dev/null || echo 'localhost')"

# ── Email delivery method: "mail" | "msmtp" | "sendmail" | "" (disabled) ──
ALERT_METHOD=""

# ── Minimum severity to alert on: "warning" | "critical" ───────────────────
ALERT_SEVERITY="warning"

# ── Webhook URL (optional — JSON POST on failure; e.g., Slack, Discord) ────
ALERT_WEBHOOK_URL=""
