# ═══════════════════════════════════════════════════════════════════════════
#  Job Automation Stack — Environment Configuration
#  Copy this to .env and fill in your values:
#    cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 | tr -d /=+ | cut -c1-24
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_USER=n8n
POSTGRES_DB=n8n

# ── n8n Encryption Key ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-a-64-char-hex-encryption-key

# ── Browserless Token (optional — set only if you want auth on the browser) ──
# Generate with: openssl rand -hex 16
BROWSERLESS_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
#  API Keys — These are configured INSIDE n8n via Credentials UI.
#  They are listed here for reference only.
# ═══════════════════════════════════════════════════════════════════════════
#
# Register for these services:
#
# 1. Adzuna API      → https://developer.adzuna.com/register
#    (Free tier: ~500 req/day)
#
# 2. Apify API       → https://console.apify.com/signup
#    (Free trial includes $5 credit)
#
# 3. OpenRouter      → https://openrouter.ai/keys
#    (Pay-per-use LLM access, ~$2/mo for job matching)
#    Alternative: Direct OpenAI/Anthropic API key
#
# 4. Google Sheets   → Configure n8n OAuth or service account
#    (For the application tracking spreadsheet)
