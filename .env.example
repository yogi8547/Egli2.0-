# ── Egli2.0 — Environment Configuration ───────────────────────
# Copy this file to .env and adjust values for your deployment.
#   cp .env.example .env
#
# All settings have sensible defaults — this file is optional.
# ──────────────────────────────────────────────────────────────────────────

# ── General ───────────────────────────────────────────────────────────────
APP_NAME="Egli2.0"
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret

# ── Backend Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── InfluxDB ──────────────────────────────────────────────────────────────
# These must match the values in docker-compose.yml
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=admin-token
INFLUXDB_ORG=monitoring
INFLUXDB_BUCKET=metrics

# ── SNMP Monitoring ───────────────────────────────────────────────────────
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_TIMEOUT=5
SNMP_RETRIES=2
POLL_INTERVAL=60  # Seconds between metric polls

# ── Ollama AI ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.3

# ── Alert Thresholds ──────────────────────────────────────────────────────
CPU_WARN=75     # CPU % for warning alerts
CPU_CRIT=90     # CPU % for critical alerts
MEM_WARN=80     # Memory % for warning alerts
MEM_CRIT=95     # Memory % for critical alerts
DISK_WARN=85    # Disk % for warning alerts
DISK_CRIT=95    # Disk % for critical alerts

# ── Development / Demo ────────────────────────────────────────────────────
SEED_MOCK=true          # Seed mock servers and metrics on startup
MOCK_SERVER_COUNT=5     # Number of mock servers to create

# ── Production Overrides ──────────────────────────────────────────────────
# Uncomment and adjust for production deployments:
# SNMP_COMMUNITY=your-secure-community
# SECRET_KEY=your-256-bit-secret-key
# OLLAMA_MODEL=mixtral:8x7b
# SEED_MOCK=false
